PORT=3010
DATA_DIR=
ADMIN_KEY=change-me

# Any OpenAI-compatible endpoint. OpenRouter works from Iran.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://openrouter.ai/api/v1
MODEL=anthropic/claude-3.5-sonnet

# How to reach you. log | telegram | both
NOTIFY_VIA=log
BUSINESS_TELEGRAM_TOKEN=
BUSINESS_TELEGRAM_CHAT_ID=

# Optional, surfaced in the widget
BUSINESS_WHATSAPP=
BUSINESS_EMAIL=
